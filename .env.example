# ==============================================================================
# Cold-Start Identity Recovery Protocol - Environment Configuration
# Copy this file to .env to override defaults
# ==============================================================================

# Recovery DNS domain for secondary dead-drop and in-browser DoH queries
# Default: recovery.yourdomain.com
RECOVERY_DOMAIN=recovery.yourdomain.com

# Optional: Cloudflare API credentials for automated DNS TXT dead-drop synchronization
# Create a scoped token at https://dash.cloudflare.com/profile/api-tokens with:
#   Permissions: Zone -> DNS -> Edit
#   Zone Resources: Include -> Specific zone -> yourdomain.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Deployment Provider: cloudflare (default), netlify, or vercel
# Can also be specified at runtime via: ./scripts/deploy.sh --provider <name>
DEPLOY_PROVIDER=cloudflare

# --- Provider 1: Cloudflare Pages Direct Upload (Default) ---
# When set, deploy.sh uploads directly to Cloudflare Pages edge without committing ciphertext to Git.
CLOUDFLARE_PAGES_PROJECT=
# Web platform (idrecoverykit.com) Pages project name (default: idrecoverykit)
CLOUDFLARE_PAGES_SITE_PROJECT=idrecoverykit
CLOUDFLARE_ACCOUNT_ID=

# --- Provider 2: Netlify Direct Upload ---
# Obtain Site ID from Site configuration -> General -> Site details
# Generate Personal Access Token at User settings -> Applications -> Personal access tokens
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# --- Provider 3: Vercel Direct Upload ---
# Generate Token at https://vercel.com/account/tokens
# (Optional) VERCEL_ORG_ID and VERCEL_PROJECT_ID if linking to a specific project
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional: Push notification webhook URL on vault staleness (ntfy.sh, Discord, Slack)
# Example (ntfy.sh): https://ntfy.sh/your_private_recovery_topic
STALENESS_WEBHOOK_URL=

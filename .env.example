# ==============================================================================
# Cold-Start Identity Recovery Protocol - Environment Configuration
# Copy this file to .env to override defaults
# ==============================================================================

# Recovery DNS domain for secondary dead-drop and in-browser DoH queries
# Default: recovery.yourdomain.com
RECOVERY_DOMAIN=recovery.yourdomain.com

# Optional: Cloudflare API credentials for automated DNS TXT dead-drop synchronization
# Create a scoped token at https://dash.cloudflare.com/profile/api-tokens with:
#   Permissions: Zone -> DNS -> Edit
#   Zone Resources: Include -> Specific zone -> yourdomain.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Optional: Push notification webhook URL on vault staleness (ntfy.sh, Discord, Slack)
# Example (ntfy.sh): https://ntfy.sh/your_private_recovery_topic
STALENESS_WEBHOOK_URL=
